<?xml version="1.0" encoding="utf-8" standalone="no"?>
<modDesc descVersion="111" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/modDesc.xsd">
    <author>MaxKra1985</author>
    <version>0.10.2.1</version>

	<title>
		<en>Construction Progress Display</en>
		<ru>Стенд прогресса строительства</ru>
	</title>

	<description>
		<en><![CDATA[Construction progress stand. Shows nearby constructible sites, construction stages, material consumption/storage/supply, responsible party and the selected object's store image.]]></en>
		<ru><![CDATA[Стенд прогресса строительства. Показывает ближайшие стройплощадки, этапы работ, расход/остаток/обеспечение материалами, ответственного и магазинное изображение выбранного объекта.]]></ru>
	</description>

	<iconFilename>icon.dds</iconFilename>
	<multiplayer supported="true"/>

	<l10n>
		<text name="storeItem_constructionProgressDisplay">
			<en>Construction Progress Stand</en>
			<ru>Стенд прогресса строительства</ru>
		</text>
		<text name="function_constructionProgressDisplay">
			<en>Physical information stand for construction progress.</en>
			<ru>Физический информационный стенд для отображения прогресса строительства.</ru>
		</text>
		<text name="warning_constructionProgressDisplay_noConstructionSiteNearby">
			<en>No construction site found nearby</en>
			<ru>Поблизости нет стройплощадки</ru>
		</text>
		<text name="warning_constructionProgressDisplay_noActiveConstructionSiteNearby">
