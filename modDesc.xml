		<text name="cpd_report_stagePageHint"><en>LMB: next page</en><ru>ЛКМ: листать</ru></text>
		<text name="cpd_report_materialPageHint"><en>RMB: next page</en><ru>ПКМ: листать</ru></text>
		<text name="input_CPD_NEXT_STAGE_PAGE"><en>Next construction-stage page</en><ru>Следующая страница этапов</ru></text>
		<text name="input_CPD_NEXT_MATERIAL_PAGE"><en>Next materials page</en><ru>Следующая страница материалов</ru></text>
		<text name="input_CPD_NEXT_CONSTRUCTION"><en>Next construction-site tab</en><ru>Следующая вкладка стройплощадки</ru></text>
	</l10n>

	<actions>
		<action name="CPD_NEXT_CONSTRUCTION" category="PLAYER" axisType="HALF"/>
		<action name="CPD_NEXT_STAGE_PAGE" category="PLAYER" axisType="HALF"/>
		<action name="CPD_NEXT_MATERIAL_PAGE" category="PLAYER" axisType="HALF"/>
	</actions>

	<inputBinding>
		<actionBinding action="CPD_NEXT_CONSTRUCTION">
			<binding device="KB_MOUSE_DEFAULT" input="KEY_r"/>
		</actionBinding>
		<actionBinding action="CPD_NEXT_STAGE_PAGE">
			<binding device="KB_MOUSE_DEFAULT" input="MOUSE_BUTTON_LEFT"/>
		</actionBinding>
		<actionBinding action="CPD_NEXT_MATERIAL_PAGE">
			<binding device="KB_MOUSE_DEFAULT" input="MOUSE_BUTTON_RIGHT"/>
		</actionBinding>
	</inputBinding>

	<storeItems>
		<storeItem xmlFilename="placeables/constructionProgressDisplay/constructionProgressDisplay.xml"/>
	</storeItems>

	<placeableTypes>
		<type name="constructionProgressDisplay" parent="simplePlaceable" className="Placeable" filename="$dataS/scripts/placeables/Placeable.lua">
			<specialization name="constructionProgressDisplay"/>
		</type>
	</placeableTypes>

	<placeableSpecializations>
		<specialization name="constructionProgressDisplay" className="ConstructionProgressDisplay" filename="scripts/ConstructionProgressDisplay.lua"/>
	</placeableSpecializations>
</modDesc>
